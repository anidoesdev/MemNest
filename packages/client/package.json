{
  "name": "@memnest/client",
  "version": "0.1.0",
  "description": "HTTP client for a Memnest server. Implements the same MemnestApi as the embedded engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anidoesdev/MemNest.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/anidoesdev/MemNest/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/anidoesdev/MemNest/issues"
  },
  "keywords": [
    "memnest",
    "memory",
    "ai-agents",
    "llm",
    "rag",
    "client",
    "http",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@memnest/core": "workspace:^"
  },
  "devDependencies": {
    "@memnest/server": "workspace:*",
    "@memnest/store-sqlite": "workspace:*"
  }
}
