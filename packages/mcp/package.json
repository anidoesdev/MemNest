{
  "name": "@memnest/mcp",
  "version": "0.0.0",
  "description": "MCP server for Memnest: give any MCP client (Claude, Cursor, VS Code, agents) long-term memory over one container.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anidoesdev/MemNest.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/anidoesdev/MemNest/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/anidoesdev/MemNest/issues"
  },
  "keywords": [
    "memnest",
    "memory",
    "ai-agents",
    "llm",
    "mcp",
    "model-context-protocol",
    "mcp-server"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stdio": {
      "import": {
        "types": "./dist/stdio.d.ts",
        "default": "./dist/stdio.js"
      },
      "require": {
        "types": "./dist/stdio.d.cts",
        "default": "./dist/stdio.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@memnest/core": "workspace:^",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@memnest/client": "workspace:*",
    "@memnest/server": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
