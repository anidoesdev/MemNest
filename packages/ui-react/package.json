{
  "name": "@memnest/ui-react",
  "version": "0.1.0",
  "description": "React bindings for @memnest/ui-core: useSyncExternalStore hooks and a canvas graph renderer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anidoesdev/MemNest.git",
    "directory": "packages/ui-react"
  },
  "homepage": "https://github.com/anidoesdev/MemNest/tree/main/packages/ui-react#readme",
  "bugs": {
    "url": "https://github.com/anidoesdev/MemNest/issues"
  },
  "keywords": [
    "memnest",
    "memory",
    "ai-agents",
    "llm",
    "ui",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@memnest/ui-core": "workspace:^"
  },
  "devDependencies": {
    "@memnest/core": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
