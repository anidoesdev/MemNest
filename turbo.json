{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["MEMNEST_TEST_DATABASE_URL"],
      "passThroughEnv": ["CI"]
    },
    "lint:pkg": {
      "dependsOn": ["build"]
    }
  }
}
