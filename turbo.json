{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "MEMNEST_TEST_DATABASE_URL"
      ],
      "passThroughEnv": [
        "CI"
      ]
    },
    "lint:pkg": {
      "dependsOn": [
        "build"
      ]
    },
    "@memnest/mcp-app#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/dashboard/src/**"
      ]
    }
  }
}
